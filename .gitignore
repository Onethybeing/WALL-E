# Python brain
brain/.env
brain/settings.json
brain/memory.db
brain/__pycache__/
brain/*.pyc

# Flutter app build artifacts (app/ has its own .gitignore for app-specific rules)
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/android/.gradle/
app/android/local.properties
# build.gradle.kts redirects most plugin build output to app/build/, but
# the root Gradle project's own output still lands here.
app/android/build/
app/*.iml

# OS noise
.DS_Store
Thumbs.db
